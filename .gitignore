# =============================================
# Root .gitignore — Warehouse Safety Monitoring System
# =============================================

# ── Dependencies ──────────────────────────────
node_modules/
venv/

# ── Python Cache ──────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Environment Variables ─────────────────────
.env
.env.*

# ── Build Output ──────────────────────────────
dist/
build/

# ── Uploaded / Generated Files ────────────────
uploads/

# ── YOLO Training Runs ────────────────────────
runs/

# ── OS / IDE ──────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Package Lock (optional, some prefer to commit) ──
# package-lock.json
